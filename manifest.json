{
  "action": {
    "default_title": "Open PixelScope Pro"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Side-panel Pixel inspector. Real facebook.com/tr network capture + fbq calls, health score, duplicate/PII/currency checks, CAPI dedup, funnel and code generator. No login, no server.",
  "homepage_url": "https://m1shop.netlify.app",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "PixelScope Pro \u2014 Meta Pixel & CAPI Doctor",
  "permissions": [
    "webRequest",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "version": "1.7.0",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "injected.js"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}